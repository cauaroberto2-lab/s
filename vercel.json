{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/featured-product.ts": {
      "includeFiles": "public/catalog.json"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|catalog\\.json$|fallback-product\\.svg$|favicon\\.ico$).*)",
      "destination": "/index.html"
    }
  ]
}
