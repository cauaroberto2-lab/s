# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Persistência durável do destaque da página inicial (defina somente na Vercel).
# Use o endpoint HTTPS e o token Standard de uma base Upstash Redis. Nunca use
# VITE_ nesses nomes: estes segredos são lidos apenas pelas funções /api.
UPSTASH_REDIS_REST_URL="https://YOUR-REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_SERVER_ONLY_REDIS_TOKEN"

# Gere dois valores diferentes, aleatórios, com pelo menos 32 caracteres.
# O primeiro é informado pelo administrador somente na tela /admin; o segundo
# assina o cookie HTTP-only da sessão e nunca é enviado ao navegador.
ADMIN_FEATURED_WRITE_TOKEN="GENERATE_A_LONG_RANDOM_SECRET"
ADMIN_FEATURED_SESSION_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"

# Opcional: identificador salvo junto à alteração para auditoria.
ADMIN_FEATURED_ADMIN_ID="pais-store-admin"
