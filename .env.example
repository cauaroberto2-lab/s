# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Persistência global do destaque da página inicial. Defina somente na Vercel
# (ou no seu ambiente de desenvolvimento); nunca use o prefixo VITE_.
UPSTASH_REDIS_REST_URL="https://YOUR-REDIS.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_SERVER_ONLY_REDIS_TOKEN"

# Alternativa automática da integração oficial “Upstash for Redis” da Vercel.
# Se a integração já criou estas variáveis, não é necessário duplicar valores
# com os nomes UPSTASH_REDIS_REST_ acima. KV_REST_API_READ_ONLY_TOKEN nunca é
# usado para salvar o destaque.
KV_REST_API_URL="https://YOUR-REDIS.upstash.io"
KV_REST_API_TOKEN="YOUR_SERVER_ONLY_REDIS_TOKEN"

# Gere dois valores distintos, aleatórios, com pelo menos 32 caracteres.
# O token é digitado pelo administrador em /#admin; o segredo assina a sessão
# HTTP-only. Nenhum dos dois é enviado para o bundle do navegador.
ADMIN_FEATURED_WRITE_TOKEN="GENERATE_A_LONG_RANDOM_SECRET"
ADMIN_FEATURED_SESSION_SECRET="GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"

# Opcional: identificador de auditoria gravado junto à alteração no Redis.
ADMIN_FEATURED_ADMIN_ID="pais-store-admin"
